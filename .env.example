# Database
POSTGRES_USER=questforge
POSTGRES_PASSWORD=questforge
POSTGRES_DB=questforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-to-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Game Engine
GAME_ENGINE_URL=http://localhost:8001

# AI Agent
# "anthropic" or "openai". Leave the keys blank to use built-in preset quests.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=

# Demo account, created automatically on startup so you can log in right away.
# These are public test credentials for local use only; disable for real deployments.
DEMO_USER_ENABLED=true
DEMO_EMAIL=demo@questforge.test
DEMO_PASSWORD=questforge-demo

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
